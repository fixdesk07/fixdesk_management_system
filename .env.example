# FixDesk — Environment Configuration
# Copy this file to the project root as .env before running docker-compose.
#
# IMPORTANT: Never commit the actual .env file to version control.
# The .gitignore already excludes it.

# ─────────────────────────────────────────
# Web Interface
# ─────────────────────────────────────────

# Port the FixDesk UI will be served on (Access via http://<SERVER-IP>:<FRONTEND_PORT>)
FRONTEND_PORT=3000

# The URL(s) the frontend is accessible from. Used to configure CORS on the backend.
# Behind NGINX on TrueNAS, requests are same-origin so CORS is rarely triggered,
# but this is required if you access the API from a different port/host.
# Separate multiple origins with commas.
FRONTEND_URL=http://<YOUR-TRUENAS-IP>:3000

# ─────────────────────────────────────────
# Database Credentials
# ─────────────────────────────────────────

DB_NAME=fixdesk
DB_USER=fixdesk_user
DB_PASS=<REPLACE-with-a-strong-password>

# ─────────────────────────────────────────
# Security
# ─────────────────────────────────────────

# JWT signing secret. MUST be a long, random string. Server will not start without this.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<REPLACE-with-generated-secret>
